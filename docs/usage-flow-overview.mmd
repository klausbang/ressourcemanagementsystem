%% Overview usage flow: what each role does, and the order the three roles work in.
%% Regenerate with: npx @mermaid-js/mermaid-cli -i docs/usage-flow-overview.mmd -o docs/usage-flow-overview.svg -b white
flowchart LR
    subgraph ADM["🔧 RMS Administrator"]
        direction TB
        A1[Create capabilities & resources]
        A2[Assign capabilities to resources]
        A3[Manage users, link technicians]
        A4[Define lab exclusion groups]
        A5[Maintain activity templates]
        A1 --> A2 --> A3 --> A4 --> A5
    end

    subgraph PLN["🗂️ Test Planner"]
        direction TB
        P1[Create customer order & EUTs]
        P2[Add test activities / apply template]
        P3[Assign resources to each test]
        P4[Schedule, watch Dashboard & conflicts]
        P1 --> P2 --> P3 --> P4
    end

    subgraph TEC["🧰 Test Technician"]
        direction TB
        T1[See assigned tests]
        T2[Create & start work order]
        T3[Run test against procedure]
        T4[Fill in & submit test report]
        T5[Peer review / approval]
        T1 --> T2 --> T3 --> T4 --> T5
    end

    ADM ==> PLN ==> TEC
    TEC -.status & results feed back.-> PLN
