%% Notation legend (see docs/er-model.html section 3 for the rendered version)
%% Relationship symbols (crow's foot):
%%   ||  = exactly one        o|  = zero or one
%%   |{  = one or many        o{  = zero or many
%%   A ||--o{ B  = one A to zero-or-many B
%%   A ||--o| B  = one A to zero-or-one B
%% Key abbreviations:
%%   PK = Primary Key (uniquely identifies a row)
%%   FK = Foreign Key (references another table's PK)
%%   UK = Unique Key (unique, non-primary column)
erDiagram
    users ||--o{ allocations : "planner_user_id"
    resources ||--o{ allocations : "resource_id"
    ordered_tests ||--o{ allocations : "ordered_test_id"
    customer_orders ||--o{ ordered_tests : "order_id"
    customer_orders ||--o{ euts : "order_id"
    euts ||--o{ ordered_tests : "eut_id (optional)"
    capabilities ||--o{ ordered_tests : "required_capability_id"
    resources ||--o{ resource_capabilities : "resource_id"
    capabilities ||--o{ resource_capabilities : "capability_id"
    resources ||--o{ users : "linked_resource_id"
    capabilities ||--o{ test_procedures : "capability_id"
    test_procedures ||--o{ procedure_checks : "procedure_id"
    ordered_tests ||--o| work_orders : "ordered_test_id"
    users ||--o{ work_orders : "technician_user_id"
    test_procedures ||--o{ work_orders : "procedure_id"
    work_orders ||--o| test_reports : "work_order_id"
    ordered_tests ||--o| test_reports : "ordered_test_id"
    test_procedures ||--o{ test_reports : "procedure_id"
    users ||--o{ test_reports : "technician_user_id"
    users ||--o{ test_reports : "reviewer_user_id"
    test_reports ||--o{ report_steps : "report_id"
    exclusion_groups ||--o{ exclusion_group_resources : "group_id"
    resources ||--o{ exclusion_group_resources : "resource_id"
    activity_templates ||--o{ activity_template_items : "template_id"
    capabilities ||--o{ activity_template_items : "required_capability_id"
    customer_orders ||--o{ milestones : "order_id"
    resources ||--o{ staff_absences : "resource_id"
    customer_orders ||--o{ customer_visits : "order_id"
    ordered_tests ||--o{ activity_history : "ordered_test_id"
    users ||--o{ activity_history : "user_id"

    users {
        int id PK
        string username UK
        string role "admin|planner|technician"
        int linked_resource_id FK "technician's own resource row, for finding their assigned tests"
    }

    resources {
        int id PK
        string code UK
        string name
        string resource_type
        string status "default available"
        string site "optional, e.g. TLC|TLS"
    }

    exclusion_groups {
        int id PK
        string name UK
        string notes
    }

    exclusion_group_resources {
        int group_id PK "also FK -> exclusion_groups.id"
        int resource_id PK "also FK -> resources.id"
    }

    capabilities {
        int id PK
        string name UK
        string description
        string discipline "optional, e.g. EMC|Environmental|Calibration"
    }

    resource_capabilities {
        int resource_id PK "also FK -> resources.id"
        int capability_id PK "also FK -> capabilities.id"
    }

    customer_orders {
        int id PK
        string order_code UK
        string customer_name
        string product_name
        string weekly_note "manual; the only free-text project status field"
        bool waiting_for_customer "manual; the only externally-caused hold flag"
    }

    milestones {
        int id PK
        int order_id FK
        string title
        string target_date "optional"
        string notes
    }

    staff_absences {
        int id PK
        int resource_id FK "the technician resource, not the user login"
        string start_date
        string end_date
        string reason "optional"
    }

    customer_visits {
        int id PK
        int order_id FK
        string start_date
        string end_date
        string notes "optional"
    }

    activity_history {
        int id PK
        int ordered_test_id FK
        string changed_at
        int user_id FK "nullable"
        string username "denormalized snapshot, survives user deletion/rename"
        string action "e.g. resource_assigned|reordered|eut_changed|work_order_started"
        string detail "human-readable description of what changed"
        string reason "optional; populated only when the acting workflow already collects a note"
    }

    euts {
        int id PK
        int order_id FK
        string name
        string serial_number
        string notes
    }

    ordered_tests {
        int id PK
        int order_id FK
        int eut_id FK "optional; which EUT this activity belongs to"
        string test_name
        int required_capability_id FK
        int sequence "display/reorder position, scoped per (order_id, eut_id)"
    }

    activity_templates {
        int id PK
        string name UK
        string notes
    }

    activity_template_items {
        int id PK
        int template_id FK
        int step_number "the template's own ordering"
        string activity_name
        int required_capability_id FK "optional"
        string notes
    }

    allocations {
        int id PK
        int ordered_test_id UK "also FK -> ordered_tests.id; UK is composite with resource_id"
        int resource_id UK "also FK -> resources.id; UK is composite with ordered_test_id"
        int planner_user_id FK
        string notes
    }

    test_procedures {
        int id PK
        int capability_id FK
        string title
        string summary
        string steps "newline-separated prose instructions"
        string equipment_needed
        string facility_needed
        string safety_notes
    }

    procedure_checks {
        int id PK
        int procedure_id FK
        int step_number
        string description
        string expected_value "pre-authored acceptance criterion, copied onto each report_steps row"
    }

    work_orders {
        int id PK
        string work_order_code UK
        int ordered_test_id UK "also FK -> ordered_tests.id; one work order per ordered test"
        int technician_user_id FK
        int procedure_id FK "nullable until technician selects a procedure"
        string status "planned|in_progress|on_hold|completed"
        string scheduled_date
        string started_at
        string completed_at
        string result "pass|fail|n_a, nullable"
        string notes
    }

    test_reports {
        int id PK
        string report_code UK
        int work_order_id UK "also FK -> work_orders.id; one report per work order"
        int ordered_test_id FK
        int procedure_id FK "nullable, source of the snapshotted report_steps"
        string uut_name
        string uut_serial_number
        int technician_user_id FK "report author, normally the work order's technician"
        string status "draft|submitted|approved|rejected"
        string technician_signed_at
        string overall_result "pass|fail|n_a, nullable"
        string notes
        int reviewer_user_id FK "nullable until reviewed; any technician/planner other than the author"
        string reviewer_decision "approved|rejected, nullable"
        string reviewer_comment
        string reviewer_signed_at
        string created_at
    }

    report_steps {
        int id PK
        int report_id FK
        int step_number
        string description
        string expected_value "copied from procedure_checks at report-creation time"
        string actual_value "filled in by the technician"
        string result "pass|fail|n_a, filled in by the technician"
    }
